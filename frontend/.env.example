# Base URL the browser calls for the API.
# "/" (default) means same-origin, which is what you want behind the dev
# proxy or when the built files are served by the same host as the API.
VITE_API_BASE_URL=/api

# Only needed for `npm run dev`: the dev server proxies /api to this origin.
VITE_BACKEND_ORIGIN=http://127.0.0.1:8000

# Dev/preview server ports.
VITE_PORT=5173
VITE_PREVIEW_PORT=4173