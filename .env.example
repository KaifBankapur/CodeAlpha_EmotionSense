# ---------------------------------------------------------------------------
# Backend configuration. Copy to `.env` and edit as needed.
#
# Every setting is optional; the defaults are safe for local development.
# There are no secrets here by design - the service needs none, so there is
# nothing for one to leak.
# ---------------------------------------------------------------------------

# --- Server ---------------------------------------------------------------
SER_HOST=127.0.0.1
SER_PORT=8000
SER_LOG_LEVEL=INFO

# --- Model selection ------------------------------------------------------
# Leave empty to follow `artifacts/active_model.json`, which is written by
# `python scripts/train.py --set-active`. Set an explicit run name (or an
# absolute path to a run directory) to pin a specific checkpoint.
# SER_MODEL_RUN=expB_lr2e3

# Fail startup when no model is available. Leave this true in any deployment:
# it turns a misconfiguration into a boot failure instead of a 500 on every
# request.
SER_REQUIRE_MODEL_ON_STARTUP=true

# --- Uploads --------------------------------------------------------------
# Ceiling for a single upload, enforced while reading the request body rather
# than trusting the declared Content-Length. Range: 1 KiB - 200 MiB.
SER_MAX_UPLOAD_BYTES=20971520

# --- CORS -----------------------------------------------------------------
# Explicit origins, comma-separated. A wildcard is rejected at startup.
SER_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Concurrency ----------------------------------------------------------
# Each forward pass is CPU-bound, so extra concurrency does not add throughput;
# this bounds how many requests can hold the model at once. Range: 1-64.
SER_MAX_CONCURRENT_PREDICTIONS=4